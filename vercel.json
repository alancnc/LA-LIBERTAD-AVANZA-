{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --workspaces --include-workspace-root --include=dev",
  "buildCommand": "cd client && npm install --no-workspaces --include=dev && npm run build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
