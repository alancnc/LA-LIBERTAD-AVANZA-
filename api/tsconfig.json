{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "server": [
        "../server/src/public.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "../server/src/**/*.ts"
  ],
  "exclude": [
    "../server/src/**/*.test.ts"
  ]
}
